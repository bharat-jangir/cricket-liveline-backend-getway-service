PORT=5000
# Comma-separated list of allowed browser origins (admin panel, webapp)
FRONTEND_URL=http://localhost:5173,http://localhost:3000
SOCKET_SERVICE_URL=http://localhost:5002
MAIN_APP_HOST=127.0.0.1
MAIN_APP_TCP_PORT=3001
# Must match the main-app JWT_SECRET. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
